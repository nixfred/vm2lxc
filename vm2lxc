#!/usr/bin/env bash
# vm2lxc: convert a QEMU VM on a Proxmox VE host into an LXC container, safely.
#
# WORK IN PROGRESS. This slice ships the read-only `preflight` and `scan`.
# `convert`, `undo` and `cleanup` are stubs that only say "not implemented".
# A plain deterministic script: no AI inside the tool.
set -euo pipefail

VM2LXC_SELF=$(readlink -f "${BASH_SOURCE[0]}")
VM2LXC_ROOT=${VM2LXC_SELF%/*}
VM2LXC_LIBDIR=${VM2LXC_LIBDIR:-$VM2LXC_ROOT/lib}

# shellcheck source=lib/common.sh
source "$VM2LXC_LIBDIR/common.sh"
# shellcheck source=lib/pve.sh
source "$VM2LXC_LIBDIR/pve.sh"
# shellcheck source=lib/qmconf.sh
source "$VM2LXC_LIBDIR/qmconf.sh"
# shellcheck source=lib/storage.sh
source "$VM2LXC_LIBDIR/storage.sh"
# shellcheck source=lib/findings.sh
source "$VM2LXC_LIBDIR/findings.sh"
# shellcheck source=lib/checks_cfg.sh
source "$VM2LXC_LIBDIR/checks_cfg.sh"
# shellcheck source=lib/guestfs.sh
source "$VM2LXC_LIBDIR/guestfs.sh"
# shellcheck source=lib/checks_guest.sh
source "$VM2LXC_LIBDIR/checks_guest.sh"
# shellcheck source=lib/sizing.sh
source "$VM2LXC_LIBDIR/sizing.sh"
# shellcheck source=lib/preflight.sh
source "$VM2LXC_LIBDIR/preflight.sh"
# shellcheck source=lib/scan.sh
source "$VM2LXC_LIBDIR/scan.sh"
# shellcheck source=lib/snapplan.sh
source "$VM2LXC_LIBDIR/snapplan.sh"
# shellcheck source=lib/hostexec.sh
source "$VM2LXC_LIBDIR/hostexec.sh"
# shellcheck source=lib/inspect.sh
source "$VM2LXC_LIBDIR/inspect.sh"
# shellcheck source=lib/convert.sh
source "$VM2LXC_LIBDIR/convert.sh"

# --answers and --no-tui are accepted so the CLI is stable; nothing consumes them until the interactive
# convert exists. Scoped disable, not a global one.
# shellcheck disable=SC2034
parse_args() {
  POSITIONAL=()
  while (($#)); do
    case $1 in
      --yes) OPT_YES=1 ;;
      --dry-run) OPT_DRY_RUN=1 ;;
      --no-tui) OPT_NO_TUI=1 ;;
      --answers)
        (($# >= 2)) || die "$EXIT_USAGE" "--answers needs a FILE"
        OPT_ANSWERS=$2
        shift
        ;;
      --answers=*) OPT_ANSWERS=${1#*=} ;;
      --node)
        (($# >= 2)) || die "$EXIT_USAGE" "--node needs a NAME"
        OPT_NODE=$2
        shift
        ;;
      --node=*) OPT_NODE=${1#*=} ;;
      --ctid | --memory | --cores | --hostname)
        (($# >= 2)) || die "$EXIT_USAGE" "$1 needs a value"
        case $1 in
          --ctid) OPT_CTID=$2 ;;
          --memory) OPT_MEMORY=$2 ;;
          --cores) OPT_CORES=$2 ;;
          --hostname) OPT_HOSTNAME=$2 ;;
        esac
        shift
        ;;
      --ctid=*) OPT_CTID=${1#*=} ;;
      --memory=*) OPT_MEMORY=${1#*=} ;;
      --cores=*) OPT_CORES=${1#*=} ;;
      --hostname=*) OPT_HOSTNAME=${1#*=} ;;
      --privileged) OPT_PRIVILEGED=1 ;;
      --start) OPT_START=1 ;;
      -h | --help) OPT_HELP=1 ;;
      --version) OPT_VERSION=1 ;;
      --)
        shift
        POSITIONAL+=("$@")
        break
        ;;
      -*) die "$EXIT_USAGE" "unknown option: $1 (try --help)" ;;
      *) POSITIONAL+=("$1") ;;
    esac
    shift
  done
}

main() {
  parse_args "$@"
  if ((OPT_HELP)); then
    usage
    exit "$EXIT_OK"
  fi
  if ((OPT_VERSION)); then
    printf 'vm2lxc %s\n' "$VM2LXC_VERSION"
    exit "$EXIT_OK"
  fi
  local cmd=${POSITIONAL[0]:-}
  if [[ -z $cmd ]]; then
    usage >&2
    exit "$EXIT_USAGE"
  fi
  case $cmd in
    preflight) cmd_preflight "${POSITIONAL[@]:1}" ;;
    scan) cmd_scan "${POSITIONAL[@]:1}" ;;
    convert) cmd_convert "${POSITIONAL[@]:1}" ;;
    undo) cmd_undo "${POSITIONAL[@]:1}" ;;
    inspect) cmd_inspect "${POSITIONAL[@]:1}" ;;
    cleanup) cmd_cleanup "${POSITIONAL[@]:1}" ;;
    help) usage ;;
    *) die "$EXIT_USAGE" "unknown command: $cmd (try --help)" ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
